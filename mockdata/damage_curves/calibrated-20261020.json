    "eventRules": {
      "noExposure": {
        "maxShare": 0.5,
        "reason": "Most of the PCS loss is where the industry book has no TIV, so the event cannot be priced."
      },
      "stalled": {
        "minHours": 36,
        "radiusNm": 100,
        "reason": "Stalled storm: the centre stayed 36+ hours within 100 nm of its strongest US landfall. Loss is driven by rainfall flooding and wind duration, which a peak-wind damage curve cannot represent (Harvey 2017 is the archetype)."
      },
      "outsideFootprint": {
        "maxShare": 0.5,
        "reason": "Most of the PCS loss is in counties outside the modelled hurricane-force wind field (inland tropical-storm-force wind, tornadoes, remnant rainfall or flooding), so the curve never sees the wind that caused it."
      }
