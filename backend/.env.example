# Exposure Eclipse — backend environment template.
# Copy to backend/.env and fill in real values. Do NOT commit secrets.

# Data provider:
#   mock     — JSON fact files only (default; multi-EDM cache + parallel load still apply)
#   hybrid   — SQL when server is in registry, else mock fact files (best for demos)
#   sqlserver— SQL only (no mock fallback; needs pyodbc + registry)
#   databricks — not implemented yet
DATA_PROVIDER=mock

# Catalog + mock fact fixtures (relative to backend/ or absolute)
MOCK_DATA_DIR=../mockdata

# ── Multi-EDM fact plane ──────────────────────────────────────────
# Cap on cached EDMs in process memory (LRU eviction beyond this).
FACT_CACHE_MAX_DATASETS=256
# Seconds before a cached EDM reloads from source (0 = only LRU, no time expiry).
FACT_CACHE_TTL_SECONDS=3600
# Parallel loads when resolving portfolio / multi-chain / multi-deal scopes.
FACT_LOAD_MAX_WORKERS=16

# ── SQL Server multi-host registry (hybrid / sqlserver) ───────────
# Copy mockdata/sql_servers.example.json → mockdata/sql_servers.json and edit.
SQLSERVER_SERVERS_FILE=../mockdata/sql_servers.json
# Or paste the same JSON map inline (handy for one-off demos):
# SQLSERVER_SERVERS_JSON={"BERMUDA-SQL01":{"host":"…","port":1433,"user":"…","password":"…"}}
SQLSERVER_DEFAULT_USER=
SQLSERVER_DEFAULT_PASSWORD=
SQLSERVER_DEFAULT_DRIVER=ODBC Driver 18 for SQL Server
# Table pattern inside each EDM database. View ee_exposure_facts is tried first.
SQLSERVER_EVOLUTION_TABLE_PATTERN={edm}__EVOLUTION
# Hybrid: fall back to mock JSON when SQL fails / server unregistered (demo).
# Firm builds: set false so failures surface as WARN_EDM_LOAD_FAILED.
HYBRID_FALLBACK_ON_SQL_ERROR=true

# Error report recipient — config only, never hardcoded (CLAUDE.md rule 8)
SUPPORT_ERROR_EMAIL=support@example.invalid

# Email transport: smtp | graph | noop
EMAIL_TRANSPORT=noop
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Excel export ceiling (triggers WARN_EXPORT_TOO_LARGE / EXPORT_TOO_LARGE)
EXPORT_MAX_ROWS=100000

# CORS — comma-separated list of allowed dev origins
# 5173 = npm run dev (proxied), 4173 = npm run preview (direct calls, needs CORS)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# Live wildfire overlay — NASA FIRMS satellite active-fire heat layer.
# Free key (email registration): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Optional: WFIGS burn-area perimeters work without it; only the satellite
# heat layer needs the key.
# FIRMS_MAP_KEY=

# v2 only
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
# DATABRICKS_WAREHOUSE_ID=
