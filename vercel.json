{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && rm -rf node_modules/.vite dist .vite node_modules/.cache && npm ci --prefer-online && npm run build && date -u +%Y%m%d-%H%M%S > dist/build-stamp.txt && echo 'build-v3 done'",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "installCommand": "echo 'install handled per workspace'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/fund-analysis/(.*)", "destination": "/index.html" },
    { "source": "/fund-analysis", "destination": "/index.html" },
    { "source": "/methodology/(.*)", "destination": "/index.html" },
    { "source": "/methodology", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "includeFiles": "mockdata/**",
      "maxDuration": 30
    }
  }
}
